# EduCraft AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJYOUR_ANON_KEY
SUPABASE_SERVICE_KEY=eyJYOUR_SERVICE_ROLE_KEY   # Keep this secret - never expose to browser

# ── STRIPE ────────────────────────────────────────────────────────────────────
# Get from: stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET     # Use sk_test_ during development
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ── STRIPE PRICE IDs ──────────────────────────────────────────────────────────
# Get from: stripe.com → Products → [your product] → Pricing
STRIPE_PRICE_PRO=price_YOUR_PRO_PRICE_ID         # $12/month
STRIPE_PRICE_SCHOOL=price_YOUR_SCHOOL_PRICE_ID   # $8/teacher/month

# ── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://educraftai.com              # No trailing slash
